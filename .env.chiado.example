# Copy to .env.chiado, fill in, then run:
#   docker compose --env-file .env.chiado -f docker-compose.chiado-node.yml up
#
# This file feeds Compose variable substitution. Each service receives only
# the values it needs; in particular, the proof-signing key is not injected
# into eez-node. Protocol addresses come from deployments.env, written by the
# one-time `make deploy-protocol`.

# ── Host paths (compose volume substitution) ─────────────────────────
# Chiado L1 snapshot — populate ONCE before first `up`:
#   docker run --rm -v "$PWD/data/chiado-l1:/data" \
#     ghcr.io/gnosischain/reth_gnosis:v2.0.0 \
#     download --chain chiado --minimal --datadir /data
L1_SNAPSHOT_DIR=./data/chiado-l1
L2_DATA_DIR=./data/eez-l2
# L2 genesis (deploy-aligned timestamp). WRITTEN BY `make deploy-protocol`
# at ./datadir/genesis.json — do NOT hand-create it; just keep this default
# and run the deploy first.
FRESH_GENESIS=./datadir/genesis.json
# Shared engine-API JWT — create once: openssl rand -hex 32 > ./data/jwt.hex
JWT_FILE=./data/jwt.hex
LIGHTHOUSE_DATA=./data/chiado-lighthouse
# Current Gnosis Chiado config, genesis, and Lighthouse bootstrap_nodes.yaml.
# Lighthouse v8.1.3's built-in --network chiado does not activate Fulu.
CHIADO_CONFIG_DIR=./configs/chiado
# Embedded-L1 engine-API port. Default 18551; override if the host already
# runs a reth on 18551 (e.g. a standalone chiado-reth used for deploys).
# L1_AUTH_PORT=18661
# L2 WebSocket RPC is bound to loopback; the public gateway terminates WSS.
EEZ_L2_WS_PORT=18689
# Lighthouse checkpoint-sync source. Default is the public chiado endpoint;
# point at a local/faster CL to speed up first sync.
# LH_CHECKPOINT_URL=https://checkpoint.chiadochain.net/
# Optional public discovery endpoint. Unset/empty keeps Lighthouse's automatic
# advertisement. If bootnodes answer WHOAREYOU but never return NODES, inspect
# /eth/v1/node/identity: an ENR without ip/udp may need both settings below.
# Use this host's actual public IPv4 (or DNS name) and externally mapped UDP
# port. The packaged profile listens on 9205; the standalone profile uses 9405.
# A DNS value is resolved at startup and disables ENR address auto-updates.
# These flags advertise an endpoint; they do not create router port mappings.
# LH_ENR_ADDRESS=<public-ip-or-dns-name>
# LH_ENR_UDP_PORT=9205

# ── Secrets / service config ─────────────────────────────────────────
# Funded chiado keys — get xDAI from a faucet (https://faucet.chiadochain.net).
# Bundle poster (pays L1 gas for postBatch); keep separate from the proof signer.
EEZ_L1_POSTER_KEY=0xCHANGE_ME
# Proof signer — MUST equal ECDSAProofSystem.signer set at deploy time.
EEZ_PROOF_SIGNER_KEY=0xCHANGE_ME
# Optional signer-specific tracing filter.
# EEZ_PROOF_SIGNER_RUST_LOG=info
# Separate L2 system signer. Deployment derives its address and funds it in the
# generated genesis; never reuse a public development key.
EEZ_L2_SYSTEM_KEY=0xCHANGE_ME
# Chiado bundle relay (rbuilder).
EEZ_L1_BUILDER_RPC_URL=https://builder.chiado.gcd.ovh/

# ── Data availability (required; Chiado is post-Fulu) ──────────────
# The colocated Lighthouse is started as a PeerDAS semi-supernode. It custodies
# half the data columns and reconstructs full blobs through the standard API on
# host loopback. An external archival Beacon API can be substituted, but it must
# serve /eth/v1/beacon/blobs/{block_id} for the complete derivation horizon.
EEZ_L1_BEACON_URL=http://127.0.0.1:6152/
# Fulu changes the pooled blob transaction propagation wrapper to EIP-7594.
EEZ_L1_BLOB_SIDECAR_ENCODING=eip7594

# ── Optional tuning overrides (Chiado deployment defaults shown) ────
# Maximum held user cross-chain txs, combined across both directions, offered
# to one Sync block. Legacy Chiado defaults to 12; the in-code fallback is 50.
# With EEZ_SETTLEMENT_POLICY_ENABLED=true, use auto to adapt to measured
# preparation time and actual gas/blob capacity. Overflow stays queued.
# EEZ_MAX_USER_TXS_PER_BUNDLE=12
# EEZ_MAX_USER_TXS_PER_BUNDLE=auto
# Stateless-validation budget + submission slack, both in ms. Defaults retain
# the rounded trigger, leaving ~800ms for preparation before the proof cutoff.
# EEZ_PROOF_TIME_MS=1500
# EEZ_SUBMISSION_SLACK_MS=700
# Optional positive preparation allowance in ms (default: unset). The trigger
# reserves preparation + proof + slack exactly; on this profile the sum must
# be <=4000ms. Set all three from measurements of the intended workloads,
# including multi-blob history. Changing timing settings requires a node restart.
# EEZ_PREPARATION_TIME_MS=500
# Earliest builder dispatch is T-7.5s by default. On Chiado's 5s slots the
# window is already open when the target parent appears, so submission occurs
# immediately after that parent is observed and revalidated.
# EEZ_BUNDLE_SUBMISSION_LEAD_MS=7500
# Bundle target-block oracle. Leave unset for the single-L1 chiado; set it
# to a tip-following node if the embedded L1 lags enough to miss target blocks.
# EEZ_L1_TARGET_RPC_URL=
# Emission + reorg bounds (see .env.example for the full rationale).
# EEZ_MAX_BLOCKS_PER_BATCH=300
# EEZ_MAX_POSTBATCH_GAS=16777216
# EEZ_L1_REORG_MAX_DEPTH_BLOCKS=62

# Configurable settlement (opt-in; docs/configurable-settlement-policy.md).
# Remove EEZ_MAX_BLOCKS_PER_BATCH before enabling. Set both positive per-unit
# fee ceilings for this network. Omitted policy settings are not empty strings.
EEZ_SETTLEMENT_POLICY_ENABLED=false
# EEZ_SETTLEMENT_PURE_L2_MODE=interval
# EEZ_SETTLEMENT_PURE_L2_INTERVAL_MS=900000
# EEZ_SETTLEMENT_MAX_UNSETTLED_L2_BLOCKS=150
# EEZ_SETTLEMENT_BLOB_FULLNESS_BPS=1000
# EEZ_MAX_SPECULATIVE_DEPTH=0
# EEZ_MAX_BLOBS_PER_BATCH=2
# EEZ_L1_POSTBATCH_MAX_FEE_PER_GAS=<positive-native-units-per-execution-gas>
# EEZ_L1_POSTBATCH_MAX_FEE_PER_BLOB_GAS=<positive-native-units-per-blob-gas>
# Unset EEZ_L1_POSTBATCH_PRIORITY_FEE to use the enabled network estimator.
# EEZ_L1_POSTBATCH_MIN_PRIORITY_FEE=0
# Optional network-estimated tip uplift: 2000 bps = +20%; default 0.
# EEZ_L1_POSTBATCH_PRIORITY_MARGIN_BPS=2000
# EEZ_L1_POSTBATCH_EXECUTION_HEADROOM_BPS=10000
# EEZ_L1_POSTBATCH_BLOB_HEADROOM_BPS=10000
# EEZ_L1_POSTBATCH_GAS_MARGIN_BPS=2000
