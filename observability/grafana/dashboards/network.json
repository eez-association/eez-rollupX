{
  "uid": "eez-network",
  "title": "EEZ \u00b7 Network overview",
  "tags": [
    "eez",
    "observability"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "eez"
      ],
      "title": "EEZ dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "eez-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"eez-observer\"}, environment)",
          "refId": "environment"
        },
        "definition": "label_values(up{job=\"eez-observer\"}, environment)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "eez-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"eez-observer\",environment=~\"$environment\"}, deployment)",
          "refId": "deployment"
        },
        "definition": "label_values(up{job=\"eez-observer\",environment=~\"$environment\"}, deployment)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "eez-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"eez-observer\",environment=~\"$environment\",deployment=~\"$deployment\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"eez-observer\",environment=~\"$environment\",deployment=~\"$deployment\"}, instance)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Observer reachable",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "up{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"$instance\",job=\"eez-observer\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Current",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
