{
  "uid": "eez-infrastructure",
  "title": "EEZ \u00b7 Infrastructure and collection",
  "tags": [
    "eez",
    "observability"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "eez"
      ],
      "title": "EEZ dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "eez-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"eez-observer\"}, environment)",
          "refId": "environment"
        },
        "definition": "label_values(up{job=\"eez-observer\"}, environment)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "eez-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"eez-observer\",environment=~\"$environment\"}, deployment)",
          "refId": "deployment"
        },
        "definition": "label_values(up{job=\"eez-observer\",environment=~\"$environment\"}, deployment)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "eez-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"eez-observer\",environment=~\"$environment\",deployment=~\"$deployment\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"eez-observer\",environment=~\"$environment\",deployment=~\"$deployment\"}, instance)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "client_instance",
        "label": "Client / host instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "eez-prometheus"
        },
        "query": {
          "query": "label_values(up{environment=~\"$environment\",deployment=~\"$deployment\",service=~\"eez-composer|eez-follower|eez-proof-signer|lighthouse|node-exporter\"}, instance)",
          "refId": "client_instance"
        },
        "definition": "label_values(up{environment=~\"$environment\",deployment=~\"$deployment\",service=~\"eez-composer|eez-follower|eez-proof-signer|lighthouse|node-exporter\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Service scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "up{environment=~\"$environment\",deployment=~\"$deployment\"}",
          "legendFormat": "{{job}} / {{instance}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "RPC collection status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "eez:collection_success:current{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"$instance\"}",
          "legendFormat": "{{source}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Current collection errors",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "description": "No error rows can mean healthy or unreachable; consult collection status.",
      "targets": [
        {
          "refId": "A",
          "expr": "eez:collection_error:current{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"$instance\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 4,
      "title": "Process memory \u00b7 monitoring and native",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "description": "Only processes exporting these metrics appear. Embedded Reth is one process across both chains. An unprefixed family takes precedence over its Reth alias for the same target; values are not summed. Missing process metrics remain unknown.",
      "targets": [
        {
          "refId": "A",
          "expr": "((process_resident_memory_bytes{environment=~\"$environment\",deployment=~\"$deployment\"}) or on(environment,deployment,job,instance) (reth_process_resident_memory_bytes{environment=~\"$environment\",deployment=~\"$deployment\"})) and on(environment,deployment,job,instance) (up{environment=~\"$environment\",deployment=~\"$deployment\"} == 1)",
          "legendFormat": "{{service}} / {{instance}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "Process CPU \u00b7 monitoring and native",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "description": "Only processes exporting these metrics appear. Embedded Reth is one process across both chains. An unprefixed family takes precedence over its Reth alias for the same target; values are not summed. Missing process metrics remain unknown.",
      "targets": [
        {
          "refId": "A",
          "expr": "((rate(process_cpu_seconds_total{environment=~\"$environment\",deployment=~\"$deployment\"}[5m])) or on(environment,deployment,job,instance) (rate(reth_process_cpu_seconds_total{environment=~\"$environment\",deployment=~\"$deployment\"}[5m]))) and on(environment,deployment,job,instance) (up{environment=~\"$environment\",deployment=~\"$deployment\"} == 1)",
          "legendFormat": "{{service}} / {{instance}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "Host available memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 6
      },
      "description": "Unknown until a private node-exporter target is configured.",
      "targets": [
        {
          "refId": "A",
          "expr": "(node_memory_MemAvailable_bytes{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"}) and on(environment,deployment,job,instance) (up{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "title": "Host filesystem available space",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 6
      },
      "description": "Unknown until a private node-exporter target is configured.",
      "targets": [
        {
          "refId": "A",
          "expr": "(node_filesystem_avail_bytes{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\",fstype!~\"tmpfs|overlay|squashfs\"}) and on(environment,deployment,job,instance) (up{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"} == 1)",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "title": "Service logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "eez-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=~\"$environment\",deployment=~\"$deployment\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "description": "Retained lifecycle streams and optional configured diagnostic JSON files. Lifecycle events are not full application logs. Sanitized node-host diagnostic logs require their own configured collector and readable producer files. Empty results do not prove that services emitted no errors."
    },
    {
      "id": 9,
      "type": "text",
      "title": "Probe placement",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "The packaged probe runs with the monitoring backend. To detect a monitoring-host outage, configure a heartbeat receiver on another machine. Optional host metrics and public RPC/signer probes require explicit targets."
      }
    },
    {
      "id": 10,
      "title": "Host CPU utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 7
      },
      "description": "Private node-exporter required. Missing scrape/rate history is unknown.",
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - avg without(cpu,mode) (rate(node_cpu_seconds_total{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\",mode=\"idle\"}[5m]))) and on(environment,deployment,job,instance) (up{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"} == 1)",
          "legendFormat": "{{instance}} {{chain}} {{profile}} {{kind}} {{direction}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 11,
      "title": "Host network traffic",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 38,
        "w": 12,
        "h": 7
      },
      "description": "Per-interface rates; do not sum virtual and physical interfaces into an assumed unique traffic total.",
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(node_network_receive_bytes_total{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\",device!=\"lo\"}[5m])) and on(environment,deployment,job,instance) (up{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"} == 1)",
          "legendFormat": "{{instance}} {{device}} receive",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "(rate(node_network_transmit_bytes_total{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\",device!=\"lo\"}[5m])) and on(environment,deployment,job,instance) (up{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"} == 1)",
          "legendFormat": "{{instance}} {{device}} transmit",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 12,
      "title": "Host disk mean operation latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 7
      },
      "description": "Per-device mean completed read/write latency. No operations gives no latency value; devices and partitions are not summed.",
      "targets": [
        {
          "refId": "A",
          "expr": "((rate(node_disk_read_time_seconds_total{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"}[5m]) / rate(node_disk_reads_completed_total{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"}[5m])) and (rate(node_disk_reads_completed_total{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"}[5m]) > 0)) and on(environment,deployment,job,instance) (up{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"} == 1)",
          "legendFormat": "{{instance}} {{device}} read",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "((rate(node_disk_write_time_seconds_total{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"}[5m]) / rate(node_disk_writes_completed_total{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"}[5m])) and (rate(node_disk_writes_completed_total{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"}[5m]) > 0)) and on(environment,deployment,job,instance) (up{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"} == 1)",
          "legendFormat": "{{instance}} {{device}} write",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 13,
      "title": "Host disk busy time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 7
      },
      "description": "Per-device I/O busy-time rate from node-exporter.",
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(node_disk_io_time_seconds_total{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"}[5m])) and on(environment,deployment,job,instance) (up{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"${client_instance:regex}\",job=\"node-exporter\"} == 1)",
          "legendFormat": "{{instance}} {{device}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
