{
  "uid": "eez-infrastructure",
  "title": "EEZ \u00b7 Infrastructure and collection",
  "tags": [
    "eez",
    "observability"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "eez"
      ],
      "title": "EEZ dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "eez-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"eez-observer\"}, environment)",
          "refId": "environment"
        },
        "definition": "label_values(up{job=\"eez-observer\"}, environment)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "eez-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"eez-observer\",environment=~\"$environment\"}, deployment)",
          "refId": "deployment"
        },
        "definition": "label_values(up{job=\"eez-observer\",environment=~\"$environment\"}, deployment)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "eez-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"eez-observer\",environment=~\"$environment\",deployment=~\"$deployment\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"eez-observer\",environment=~\"$environment\",deployment=~\"$deployment\"}, instance)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Service scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "up{environment=~\"$environment\",deployment=~\"$deployment\"}",
          "legendFormat": "{{job}} / {{instance}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "RPC collection status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "eez:collection_success:current{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"$instance\"}",
          "legendFormat": "{{source}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Current collection errors",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "description": "No error rows can mean healthy or unreachable; consult collection status.",
      "targets": [
        {
          "refId": "A",
          "expr": "eez:collection_error:current{environment=~\"$environment\",deployment=~\"$deployment\",instance=~\"$instance\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 4,
      "title": "Monitoring process memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{environment=~\"$environment\",deployment=~\"$deployment\"}",
          "legendFormat": "{{job}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "Monitoring process CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{environment=~\"$environment\",deployment=~\"$deployment\"}[5m])",
          "legendFormat": "{{job}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "Host available memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 6
      },
      "description": "Unknown until a private node-exporter target is configured.",
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{environment=~\"$environment\",deployment=~\"$deployment\",job=\"node-exporter\"}",
          "legendFormat": "",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "title": "Host filesystem available space",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eez-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 6
      },
      "description": "Unknown until a private node-exporter target is configured.",
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{environment=~\"$environment\",deployment=~\"$deployment\",job=\"node-exporter\",fstype!~\"tmpfs|overlay|squashfs\"}",
          "legendFormat": "{{mountpoint}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "title": "Service logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "eez-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=~\"$environment\",deployment=~\"$deployment\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "description": "Files from the explicitly configured JSON log directory. Empty results do not prove that services emitted no errors."
    },
    {
      "id": 9,
      "type": "text",
      "title": "Probe placement",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "The packaged probe runs with the monitoring backend. To detect a monitoring-host outage, configure a heartbeat receiver on another machine. Optional host metrics and public RPC/signer probes require explicit targets."
      }
    }
  ]
}
