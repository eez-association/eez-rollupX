+/// The value must drop before its completion sender, including an unrun task's captures.
+#[derive(Clone)]
+struct ShutdownOwned<T> {
+    inner: T,
+    owner: Option<CrossbeamSender<()>>,
+}
+
+impl<T> ShutdownOwned<T> {
+    const fn new(inner: T, owner: Option<CrossbeamSender<()>>) -> Self {
+        Self { inner, owner }
+    }
+
+    fn run<R>(self) -> R
+    where
+        T: FnOnce() -> R,
+    {
+        let Self { inner, owner } = self;
+        let result = inner();
+        drop(owner);
+        result
+    }
+}
+
+impl<F: DatabaseProviderROFactory> DatabaseProviderROFactory for ShutdownOwned<F> {
+    type Provider = F::Provider;
+
+    fn database_provider_ro(&self) -> ProviderResult<Self::Provider> {
+        self.inner.database_provider_ro()
+    }
+}
