+    fn witness(
+        &self,
+        _: reth_trie_common::TrieInput,
+        _: HashedPostState,
+        _: reth_trie_common::ExecutionWitnessMode,
+    ) -> ProviderResult<Vec<alloy_primitives::Bytes>> {
+        unreachable!("proof worker uses multiproof_v2")
+    }
+}
