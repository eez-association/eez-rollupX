diff --git a/script/e2e/shared/E2EBase.sh b/script/e2e/shared/E2EBase.sh
index e540631..9dc8815 100755
--- a/script/e2e/shared/E2EBase.sh
+++ b/script/e2e/shared/E2EBase.sh
@@ -903,6 +903,39 @@ _poll_receipt() {
     return 1
 }
 
+# An L2 receipt can name an optimistic block that is replaced when its L1
+# settlement misses inclusion. Re-read it until its current block is canonical
+# and covered by the safe head before choosing blocks for protocol verification.
+# Return the receipt unchanged; status and table/event checks stay with callers.
+_poll_safe_l2_receipt() {
+    local rpc="$1" tx_hash="$2" deadline="$3"
+    local out receipt number hash safe_number canonical_hash
+    while [[ $(date +%s) -lt $deadline ]]; do
+        out=$(_eez_rpc "$rpc" eth_getTransactionReceipt "[\"$tx_hash\"]") || out=""
+        receipt=$(jq -ce --arg tx "$tx_hash" '.result | select(type == "object") |
+            select(.transactionHash == $tx) |
+            select(.blockNumber | type == "string" and test("^0x[0-9a-fA-F]+$")) |
+            select(.blockHash | type == "string" and test("^0x[0-9a-fA-F]{64}$"))' <<< "$out" 2>/dev/null) || receipt=""
+        if [[ -n "$receipt" ]]; then
+            number=$(jq -r .blockNumber <<< "$receipt")
+            hash=$(jq -r .blockHash <<< "$receipt")
+            out=$(_eez_rpc "$rpc" eth_getBlockByNumber '["safe",false]') || out=""
+            safe_number=$(jq -er '.result.number | select(type == "string" and test("^0x[0-9a-fA-F]+$"))' <<< "$out" 2>/dev/null) || safe_number=""
+            if [[ -n "$safe_number" ]] && (( number >= 0 && safe_number >= 0 && number <= safe_number )); then
+                out=$(_eez_rpc "$rpc" eth_getBlockByNumber "[\"$number\",false]") || out=""
+                canonical_hash=$(jq -er --arg number "$number" '.result | select(.number == $number) | .hash' <<< "$out" 2>/dev/null) || canonical_hash=""
+                if [[ "${canonical_hash,,}" == "${hash,,}" ]]; then
+                    printf '%s\n' "$receipt"
+                    return 0
+                fi
+            fi
+        fi
+        sleep 2
+    done
+    echo "ERROR: no canonical safe L2 receipt for tx $tx_hash before the receipt deadline" >&2
+    return 1
+}
