diff --git a/script/e2e/tests/test_safe_receipt.py b/script/e2e/tests/test_safe_receipt.py
new file mode 100644
index 0000000..0520585
--- /dev/null
+++ b/script/e2e/tests/test_safe_receipt.py
@@ -0,0 +1,111 @@
+"""The network verifier must follow a replaced L2 receipt to settled history."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+
+TX = "0x" + "11" * 32
+OLD = "0x" + "22" * 32
+NEW = "0x" + "33" * 32
+EMPTY = "0x" + "44" * 32
+HELPERS = Path(__file__).resolve().parents[1] / "shared" / "E2EBase.sh"
+
+
+def receipt(number, block_hash, status="0x1"):
+    return dict(transactionHash=TX, blockNumber=hex(number), blockHash=block_hash, status=status)
+
+
+def rpc(method, params, result):
+    return dict(method=method, params=params, response={"jsonrpc": "2.0", "id": 1, "result": result})
+
+
+def query_receipt(value):
+    return rpc("eth_getTransactionReceipt", [TX], value)
+
+
+def query_block(tag, number, block_hash):
+    return rpc("eth_getBlockByNumber", [tag, False], {"number": hex(number), "hash": block_hash})
+
+
+class SafeReceiptTests(unittest.TestCase):
+    def poll(self, responses, *, deadline=4):
+        with tempfile.TemporaryDirectory() as temporary:
+            directory = Path(temporary)
+            (directory / "responses.json").write_text(json.dumps(responses))
+            (directory / "index").write_text("0")
+            (directory / "clock").write_text("0")
+            fixture = directory / "rpc.py"
+            fixture.write_text('''import json, os, pathlib, sys
+p = pathlib.Path(os.environ["FIXTURE"])
+responses = json.loads((p / "responses.json").read_text())
+index = int((p / "index").read_text())
+if index >= len(responses):
+    raise SystemExit("unexpected extra RPC")
+row = responses[index]
+assert (sys.argv[1], json.loads(sys.argv[2])) == (row["method"], row["params"])
+(p / "index").write_text(str(index + 1))
+print(json.dumps(row["response"]))
+''')
+            env = os.environ | {"FIXTURE": temporary, "HELPERS": str(HELPERS), "TX": TX, "DEADLINE": str(deadline)}
+            result = subprocess.run(["bash", "-c", '''source "$HELPERS"
+date() { cat "$FIXTURE/clock"; }
+sleep() { local tick; tick=$(cat "$FIXTURE/clock"); echo $((tick + 1)) > "$FIXTURE/clock"; }
+_eez_rpc() { python3 "$FIXTURE/rpc.py" "$2" "$3"; }
+_poll_safe_l2_receipt fixture "$TX" "$DEADLINE"
+'''], env=env, text=True, capture_output=True, timeout=10)
+            self.assertNotIn("unexpected extra RPC", result.stderr)
+            self.assertNotIn("AssertionError", result.stderr)
+            self.assertEqual(int((directory / "index").read_text()), len(responses))
+            return result
+
+    def test_follows_receipt_moved_after_missed_inclusion(self):
+        settled = receipt(900, NEW)
+        result = self.poll([
+            query_receipt(receipt(882, OLD)), query_block("safe", 876, EMPTY),
+            query_receipt(None),
+            query_receipt(settled), query_block("safe", 900, NEW), query_block("0x384", 900, NEW),
+        ])
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(json.loads(result.stdout), settled)
+
+    def test_rejects_orphan_receipt_even_below_safe_height(self):
+        settled = receipt(900, NEW)
+        result = self.poll([
+            query_receipt(receipt(882, OLD)), query_block("safe", 900, NEW), query_block("0x372", 882, EMPTY),
+            query_receipt(settled), query_block("safe", 900, NEW), query_block("0x384", 900, NEW),
+        ])
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(json.loads(result.stdout), settled)
+
+    def test_preserves_reverted_transaction_status(self):
+        settled = receipt(900, NEW, status="0x0")
+        result = self.poll([query_receipt(settled), query_block("safe", 900, NEW), query_block("0x384", 900, NEW)])
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(json.loads(result.stdout), settled)
+
+    def test_missing_receipt_times_out(self):
+        result = self.poll([query_receipt(None)] * 3, deadline=3)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, "")
+        self.assertIn("no canonical safe L2 receipt", result.stderr)
+
+    def test_malformed_or_unrelated_receipt_does_not_pass(self):
+        unrelated = receipt(900, NEW) | {"transactionHash": "0x" + "55" * 32}
+        malformed = receipt(900, NEW) | {"blockNumber": "not-a-number"}
+        result = self.poll([query_receipt(unrelated), query_receipt(malformed)], deadline=2)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, "")
+
+    def test_unavailable_safe_head_does_not_fall_back_to_latest(self):
+        unavailable = {"method": "eth_getBlockByNumber", "params": ["safe", False],
+                       "response": {"jsonrpc": "2.0", "id": 1, "error": {"code": -32602, "message": "unsupported tag"}}}
+        result = self.poll([query_receipt(receipt(900, NEW)), unavailable], deadline=1)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, "")
+
+
+if __name__ == "__main__":
+    unittest.main()
