 fi  # ── end of the full/prepare-stage block (steps 1–4); verification below is stage-shared ──
 
+# A missed settlement can move an L2 trigger after its first receipt. Eventless
+# rollback scenarios have no surviving call event to repair a stale block scan.
+# Both the full and staged paths must select the current settled receipt before
+# correlating L1 or verifying the loaded L2 table.
+if [[ "$_TRIGGER_CHAIN" == "L2" ]]; then
+    echo "Waiting for canonical safe L2 trigger receipts"
+    _safe_receipt_deadline=$(( $(date +%s) + ${RECEIPT_TIMEOUT:-300} ))
+    _trigger_hashes=("${TX_HASHES[@]}")
+    (( ${#_trigger_hashes[@]} > 0 )) || _trigger_hashes=("$TX_HASH")
+    TX_BLOCK_NUMBERS=()
+    for _hash in "${_trigger_hashes[@]}"; do
+        _safe_receipt=$(_poll_safe_l2_receipt "$L2_RPC" "$_hash" "$_safe_receipt_deadline") || exit 1
+        _safe_number=$(jq -r .blockNumber <<< "$_safe_receipt")
+        TX_BLOCK_NUMBERS+=("$(printf '%d' "$_safe_number")")
+        echo "settled tx: $_hash block: $_safe_number hash: $(jq -r .blockHash <<< "$_safe_receipt")"
+    done
+    TX_BLOCK_NUMBER="${TX_BLOCK_NUMBERS[0]}"
+    for _number in "${TX_BLOCK_NUMBERS[@]}"; do
+        (( _number < TX_BLOCK_NUMBER )) && TX_BLOCK_NUMBER="$_number"
+    done
+    L2_BLOCK="$TX_BLOCK_NUMBER"
+fi
