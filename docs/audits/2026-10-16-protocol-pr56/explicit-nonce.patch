diff --git a/script/e2e/RPC.md b/script/e2e/RPC.md
index a61f6fb..2464c26 100644
--- a/script/e2e/RPC.md
+++ b/script/e2e/RPC.md
@@ -49,11 +49,15 @@ Use discovery instead of copying deployment addresses from an older run.
 
 **Params:**
 ```json
-[{"from":"<funded sender>","to":"<deployed target>","data":"<exact calldata>","value":"0x0"}]
+[{"from":"<funded sender>","to":"<deployed target>","data":"<exact calldata>","value":"0x0","nonce":"<prepared nonce>"}]
 ```
 
 `value` is the native amount in wei as a hex quantity; replace `0x0` for a
 nonzero transfer. Quote after deployment, immediately before signing and sending.
+Pass the prepared nonce as a hex quantity. On L1, omitting it selects the canonical
+nonce, which can already belong to a queued trigger. The deployed composer can
+replay its owned L1 predecessors when the next transaction supplies its nonce;
+this preserves same-account bursts without waiting for each transaction to mine.
 
 Version 1 returns `chainId`, `nonce`, `expiresAt` (Unix seconds) and `options[]`.
 Older deployments also returned `recoveryMode`. Chain ID, nonce, expiry and option
diff --git a/script/e2e/lib/network-fees.sh b/script/e2e/lib/network-fees.sh
index c7ed243..af073da 100644
--- a/script/e2e/lib/network-fees.sh
+++ b/script/e2e/lib/network-fees.sh
@@ -88,7 +88,9 @@ network_fee_quote() { # transaction, front, read RPC, optional checked chain and
     local intent quote option nonce kind gas cap tip value expires attempt deadline left rpc_timeout rc failure
     local retry_reason=reconciliation
     [[ -n "$chain" ]] || chain=$(network_fee_chain "$tx" "$front" "$read_rpc") || return 1
-    intent=$(jq -c '{from:.signer,to:.to,data:.input,value:.value}' <<< "$tx") || return 1
+    # An omitted L1 nonce selects canonical state, which may already have a held
+    # trigger. The explicit nonce lets Composer replay its owned L1 predecessors.
+    intent=$(jq -c '{from:.signer,to:.to,data:.input,value:.value,nonce:.nonce}' <<< "$tx") || return 1
     # Quotes can be unavailable while earlier native/cross-chain activity is
     # settling. Retry only those explicit transient responses under one deadline.
     [[ "${EEZ_QUOTE_TIMEOUT:-120}" =~ ^[1-9][0-9]*$ ]] || { echo 'EEZ_QUOTE_TIMEOUT must be positive seconds' >&2; return 1; }
@@ -171,7 +173,7 @@ network_node_fee_plan() { # validated trigger, source read RPC, chain -> fresh n
     [[ $(bc <<< "$gas > 0 && $cap > 0 && $tip >= 0 && $cap >= $tip") == 1 ]] || return 1
     jq -nc --argjson tx "$tx" --arg chain "$chain" --arg nonce "$nonce" \
         --arg gas "$gas" --arg cap "$cap" --arg tip "$tip" --arg value "$value" \
-        '{feeSource:"node",transaction:$tx,intent:($tx|{from:.signer,to:.to,data:.input,value:.value}),
+        '{feeSource:"node",transaction:$tx,intent:($tx|{from:.signer,to:.to,data:.input,value:.value,nonce:.nonce}),
           quote:null,selectedOption:null,expires:null,
           chain:$chain,nonce:$nonce,gas:$gas,cap:$cap,tip:$tip,value:$value}'
 }
