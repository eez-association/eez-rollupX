# eez L2 against an external Kurtosis devnet L1 (12s blocks, chain 7331).
#
#   cp .env.kurtosis.example .env.kurtosis     # then fill in the enclave values
#   docker compose --env-file .env.kurtosis -f docker-compose.kurtosis-node.yml up -d
#
# Every 3xxxx port below is assigned by Kurtosis and CHANGES when the enclave is
# recreated. Read them back with `kurtosis enclave inspect <enclave>`; do not
# assume the values here.

# ── Host paths ───────────────────────────────────────────────────────────
# The enclave's L1 genesis artifact: kurtosis files download <enclave> el_cl_genesis_data
L1_GENESIS_DIR=/abs/path/to/l1-genesis
L2_DATA_DIR=/abs/path/to/data/kurtosis-l2
# openssl rand -hex 32 > this file
JWT_FILE=/abs/path/to/data/jwt-kurtosis.hex
# Written by `make deploy-protocol`, timestamp and seed pinned to the finalized L1 reference.
FRESH_GENESIS=/abs/path/to/datadir/genesis.json

# ── Kurtosis L1 endpoints ────────────────────────────────────────────────
# Canonical EL, for the next-block target oracle (el-1 RPC).
EEZ_L1_TARGET_RPC_URL=http://127.0.0.1:34817
# MUST be el-2's rbuilder-rpc port, NOT el-1's RPC. Point this at a plain EL and
# eth_sendBundle answers -32601; there is no mempool fallback, so every dispatch
# fails as unsupported and settlement stalls.
# Verify before a run:
#   curl -s -X POST <url> -H 'content-type: application/json' \
#     -d '{"jsonrpc":"2.0","method":"eth_sendBundle","params":[{"txs":[],"blockNumber":"0x0"}],"id":1}'
# A result (even null) means it speaks the method; -32601 means wrong port.
# Several relays may be listed comma-separated; each bundle goes to all of them.
EEZ_L1_BUILDER_RPC_URL=http://127.0.0.1:34826
# Beacon HTTP, used as the follower CL's checkpoint-sync source.
L1_BEACON_URL=http://127.0.0.1:34829

# ── Peering into the enclave ─────────────────────────────────────────────
# The embedded L1 joins as a trusted peer: el-1's enode, with the host-mapped
# port substituted for the in-enclave one.
EEZ_L1_TRUSTED_PEERS=enode://<el-1-node-id>@127.0.0.1:34821
# The follower CL peers the enclave CL directly; discovery alone is too sparse.
CL_MULTIADDR=/ip4/127.0.0.1/tcp/34831/p2p/<cl-peer-id>
CL_PEERID=<cl-peer-id>

# ── Keys (dev/devnet only — never reuse on a public network) ─────────────
# Signs postAndVerifyBatch. Use an EOA no other composer posts from, or the two
# race each other's nonces.
EEZ_L1_POSTER_KEY=0x<poster-private-key>
# Optional (deploy.sh): L2 recipient of ether swept from cross-chain proxy
# addresses at deployment, baked into the EEZL2 genesis. Defaults to the poster.
# EEZ_L2_RECOVERY_ADDRESS=
# Optional (deploy.sh): owners of the ProxyAdmins that can replace the L1 EEZ
# registry, Rollup and L2 EEZL2 implementations. All default to the deployer.
# The EEZL2 owner is baked into genesis and needs L2 gas to upgrade.
# EEZ_UPGRADE_OWNER=
# EEZ_ROLLUP_UPGRADE_OWNER=
# EEZ_L2_UPGRADE_OWNER=
# Required: coinbase of every L2 block (receives priority fees). Compose refuses
# to start while empty; the zero address is allowed if set deliberately.
EEZ_L2_FEE_RECIPIENT=
# Signs the proof attestation; native L2 transactions need no key.
EEZ_PROOF_SIGNER_KEY=0x<attester-private-key>
EEZ_ATTESTER_ADDRESS=0x<address-of-EEZ_PROOF_SIGNER_KEY>
# Fixed native system identity; no signing key or fee funding.
EEZ_L2_SYSTEM_ADDRESS=0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee0076

# Explicit private-network cadence, shared by deployment and runtime.
EEZ_L1_BLOCK_TIME_MS=12000
EEZ_L2_BLOCK_TIME_MS=2000
# Optional conditional production on this K=6 grid. The Compose profile's
# proof/slack defaults fit P=3. Leave EEZ_PREPARATION_TIME_MS absent.
# See docs/configurable-settlement-policy.md#conditional-slot-production;
# leave disabled until the draft release gates pass.
# EEZ_SETTLEMENT_START_AFTER_BLOCK=3

# ── Sizing ───────────────────────────────────────────────────────────────
# Held cross-chain txs, combined across both directions, offered per Sync block.
# Overflow stays FIFO-queued. The whole bundle [postBatch, user_tx...] must fit
# one L1 block. Use auto for admission
# based on measured preparation time and the selected network's gas/blob limits.
EEZ_MAX_USER_TXS_PER_BUNDLE=50
# Earliest dispatch relative to the selected target timestamp. The default
# waits until T-7.5s so builders with a T-8s bid gate retain the candidate.
EEZ_BUNDLE_SUBMISSION_LEAD_MS=7500
EEZ_SIGNER_PORT=50081
EEZ_PROOF_SIGNER_RUST_LOG=info

# ── Sharing the L1 with another composer ─────────────────────────────────
# Treat peer batches as expected rather than "someone else is sequencing".
EEZ_COMPOSER_EXPECT_EXTERNAL_BATCHES=true
# Only needed to outbid a competing composer for the same L1 slot.
EEZ_L1_POSTBATCH_PRIORITY_FEE=30000000000
EEZ_L1_POSTBATCH_MAX_PRIORITY_FEE=30000000000

# Settlement policy (required; docs/configurable-settlement-policy.md).
EEZ_SETTLEMENT_PURE_L2_MODE=interval
EEZ_SETTLEMENT_PURE_L2_INTERVAL_MS=900000
EEZ_SETTLEMENT_MAX_UNSETTLED_L2_BLOCKS=150
# EEZ_SETTLEMENT_BLOB_FULLNESS_BPS=1000
EEZ_MAX_SPECULATIVE_DEPTH=0
# EEZ_MAX_BLOBS_PER_BATCH=2
EEZ_L1_POSTBATCH_MAX_FEE_PER_GAS=100000000000
EEZ_L1_POSTBATCH_MAX_FEE_PER_BLOB_GAS=100000000000
# Unset EEZ_L1_POSTBATCH_PRIORITY_FEE to use canonical fee history.
# EEZ_L1_POSTBATCH_MIN_PRIORITY_FEE=0
# Dynamic estimation requires an independent maximum; fixed mode safely uses
# its exact override as the maximum when this setting is absent.
# EEZ_L1_POSTBATCH_MAX_PRIORITY_FEE=2000000000
# EEZ_L1_POSTBATCH_EXECUTION_HEADROOM_BPS=10000
# EEZ_L1_POSTBATCH_BLOB_HEADROOM_BPS=10000
# EEZ_L1_POSTBATCH_GAS_MARGIN_BPS=500
