diff --git a/packages/chains/src/chains/devnet.ts b/packages/chains/src/chains/devnet.ts
new file mode 100644
index 00000000..8d915633
--- /dev/null
+++ b/packages/chains/src/chains/devnet.ts
@@ -0,0 +1,17 @@
+import { Chain } from "../Chain";
+
+// This image is built for exactly one disposable EEZ devnet chain. The
+// placeholder is replaced by testing/kurtosis/blobscan/build.sh before the
+// image is built, so API and web never claim to index a different chain ID.
+// The pinned ethereum-package profile activates Fulu and BPO1 at genesis.
+export const devnet = new Chain(
+  __EEZ_BLOBSCAN_CHAIN_ID__,
+  "devnet",
+  { number: 0 },
+  {
+    bpo1: {
+      activationDate: new Date(0),
+      activationSlot: 0,
+    },
+  }
+);
