# syntax=docker/dockerfile:1
# Deploy contracts and generate the L2 genesis inside the CI enclave.

ARG EEZ_NODE_IMAGE=eez-node:dev
ARG RUNTIME_IMAGE=debian:bookworm-slim
FROM ${EEZ_NODE_IMAGE} AS node-tools

FROM ${RUNTIME_IMAGE}

ARG FOUNDRY_VERSION=v1.7.1

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash git jq python3 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.foundry/bin:${PATH}"
RUN curl -L https://foundry.paradigm.xyz | bash \
    && foundryup -i "${FOUNDRY_VERSION}"

COPY --from=node-tools /usr/local/bin/eez-genesis-state-root /usr/local/bin/eez-genesis-state-root
COPY --from=node-tools /usr/local/bin/eez-genesis-block-hash /usr/local/bin/eez-genesis-block-hash

WORKDIR /repo
COPY scripts ./scripts
COPY contracts ./contracts
# --render verifies the proxy, initial implementation and admin identities.
COPY crates/eez-protocol/src/l1_history/runtime.bin crates/eez-protocol/src/l1_history/implementation.bin crates/eez-protocol/src/l1_history/proxy_admin.bin ./crates/eez-protocol/src/l1_history/
COPY eez-core-protocol ./eez-core-protocol
# genesis.json is the ETH-free production base; genesis.dev.json additionally
# funds the public development keys used by Kurtosis and test networks.
COPY genesis.json genesis.dev.json ./
# Deployment values are injected by the Kurtosis task.
RUN touch /repo/.env

ENTRYPOINT ["/bin/bash", "-c"]
CMD ["bash /repo/scripts/deploy.sh"]
