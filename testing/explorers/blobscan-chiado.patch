+import { Chain } from "../Chain";
+
+// Local explorer coverage begins with the EEZ deployment. This is the
+// navigation floor, not a claim that Chiado had no blobs before this block.
+// Fork dates and gas parameters match reth_gnosis 7e588a7's Chiado preset.
+export const chiado = new Chain(
+  10200,
+  "chiado",
+  { number: 23_043_686 },
+  {
+    dencun: {
+      activationDate: new Date(1706724940 * 1000),
+      activationSlot: 8_265_728,
+    },
+    pectra: {
+      activationDate: new Date(1741254220 * 1000),
+      activationSlot: 15_171_584,
+    },
+  },
+  16
+);
+
+// Chiado keeps these same parameters through Fulu. Override this instance's
+// fork parameters without changing Ethereum's shared presets.
+for (const fork of chiado.forks) {
+  fork.blobParams = {
+    ...fork.blobParams,
+    maxBlobsPerBlock: 2,
+    targetBlobsPerBlock: 1,
+    minBlobBaseFee: BigInt(1_000_000_000),
+    blobBaseFeeUpdateFraction: BigInt(1_112_826),
+    blobGasLimit: BigInt(262_144),
+    targetBlobGasPerBlock: BigInt(131_072),
+  };
+}
