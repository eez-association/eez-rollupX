+import { Copyable } from "../Copyable";
+
+export function BlobProofDisplay({ proof }: { proof: string }) {
+  const { env } = useEnv();
+  if (!env) return null;
+
+  // This local Chiado archive begins after Fulu. Lighthouse's legacy sidecar
+  // endpoint returns empty blob proofs; PeerDAS uses cell proofs instead.
+  if (env.PUBLIC_NETWORK_NAME === "chiado") {
+    return <span>Not supplied by beacon API (Fulu)</span>;
+  }
+
+  return <Copyable value={proof} tooltipText="Copy proof" />;
+}
