# Copy to .env and fill in. Runbook: docs/runbooks/ethereum-node.md
#
# This file feeds Compose variable substitution. Each service receives only
# the values it needs; in particular, the proof-signing key is not injected
# into eez-node. Protocol addresses come from the generated deployments.env.
# Compose loads .env automatically; this selects the Ethereum service definition.
COMPOSE_FILE=docker-compose.ethereum-node.yml

# ── Network ─────────────────────────────────────────────────────────
# One value selects the embedded L1, the signer's trusted L1 profile and
# Lighthouse: mainnet, or hoodi / sepolia for a rehearsal with the same stack.
# The chain ID must match it: 1 (mainnet), 560048 (hoodi), 11155111 (sepolia).
EEZ_L1_NETWORK=mainnet
EEZ_L1_CHAIN_ID=1

# ── Deployment RPC and keys ──────────────────────────────────────────
# Synchronized external execution RPC for EEZ_L1_NETWORK (deployment tooling).
EEZ_L1_RPC_URL=https://YOUR_ETHEREUM_RPC
# Poster pays settlement gas. Fund it on EEZ_L1_NETWORK.
EEZ_L1_POSTER_KEY=0xCHANGE_ME
# Required: coinbase of every L2 block (receives priority fees). Compose refuses
# to start while empty.
EEZ_L2_FEE_RECIPIENT=
# Independent attester registered in the deployed proof system.
EEZ_PROOF_SIGNER_KEY=0xCHANGE_ME
# Optional separate funded contract deployer/owner.
# EEZ_DEPLOY_KEY=0xCHANGE_ME

# ── Runtime images ──────────────────────────────────────────────────
# Required, and deliberately without a default: pin all three to the same full
# Git commit tag (or each image's @sha256:<digest>). Node and signer must come
# from the same commit; :latest could split them on a restart.
EEZ_NODE_IMAGE=ghcr.io/eduadiez/rollupx-node:<full-commit>
EEZ_PROOF_SIGNER_IMAGE=ghcr.io/eduadiez/rollupx-proof-signer:<full-commit>
EEZ_DEPLOY_IMAGE=ghcr.io/eduadiez/rollupx-deploy:<full-commit>

# ── Host paths (compose volume substitution) ─────────────────────────
# Embedded L1 datadir: a reth datadir synced for EEZ_L1_NETWORK that reth v2.7
# can open, or an empty directory to sync from scratch (days on mainnet). Stop
# any other reth using it first: the Composer becomes its only writer.
L1_SNAPSHOT_DIR=./data/ethereum-l1
L2_DATA_DIR=./data/eez-l2
# Bounded posting logs for the optional monitoring collector, separate from DBs.
POSTING_LOGS_DIR=./data/posting-logs
# Registered L2 genesis. Render it before registration and never edit it after.
FRESH_GENESIS=./datadir/genesis.json
# Shared engine-API JWT — create once: openssl rand -hex 32 > ./data/jwt.hex
# Reusing an existing Lighthouse datadir? Use its JWT file here.
JWT_FILE=./data/jwt.hex
LIGHTHOUSE_DATA=./data/ethereum-lighthouse
# Embedded-L1 engine-API and P2P ports. Override if the host already runs an
# execution client on them.
# L1_AUTH_PORT=18551
# L1_P2P_PORT=30544
# L2 WebSocket RPC is bound to loopback.
EEZ_L2_WS_PORT=18689
# Lighthouse checkpoint-sync source (used only for an empty LIGHTHOUSE_DATA):
#   mainnet https://mainnet.checkpoint.sigp.io
#   hoodi   https://checkpoint-sync.hoodi.ethpandaops.io
#   sepolia https://checkpoint-sync.sepolia.ethpandaops.io
LH_CHECKPOINT_URL=https://mainnet.checkpoint.sigp.io
# Lighthouse P2P ports, and optional public discovery endpoint (see
# .env.chiado.example for when the ENR settings are needed).
# LH_P2P_PORT=9205
# LH_QUIC_PORT=9206
# LH_ENR_ADDRESS=<public-ip-or-dns-name>
# LH_ENR_UDP_PORT=9205

# ── Builders ────────────────────────────────────────────────────────
# Every bundle goes to all listed builders; one acknowledgement suffices.
# Each accepted the Composer's exact bundle shape (EIP-7594 blob tx, pinned
# min/maxTimestamp, revertingTxHashes) on 2026-10-02; acceptance is not
# inclusion, so measure inclusion before relying on it.
# Hoodi: https://rpc-hoodi.titanbuilder.xyz
EEZ_L1_BUILDER_RPC_URL=https://rpc.titanbuilder.xyz,https://rpc.buildernet.org,https://rpc.quasar.win
# Required by BuilderNet; Quasar verifies it when present; Titan ignores it.
# Use a dedicated key with no funds: it signs request bodies only, never
# transactions, and builders treat its address as your searcher identity.
EEZ_L1_BUNDLE_SIGNING_KEY=0xCHANGE_ME

# ── Data availability (required; Ethereum is post-Fulu) ────────────
# The colocated Lighthouse runs as a PeerDAS semi-supernode and reconstructs
# full blobs on host loopback. An external Beacon API can be substituted only
# if it serves /eth/v1/beacon/blobs/{block_id} for the derivation horizon.
EEZ_L1_BEACON_URL=http://127.0.0.1:6152/
EEZ_L1_BLOB_SIDECAR_ENCODING=eip7594

# ── Timing and admission ───────────────────────────────────────────
EEZ_PROOF_SIGNER_MAX_REQUEST_BLOCKS=2048
EEZ_MAX_USER_TXS_PER_BUNDLE=auto
# Preparation, proof and submission reservations in milliseconds. These are the
# Chiado values; the 12-second grid has only been exercised in fixtures, so
# confirm them in the rehearsal before mainnet.
EEZ_PROOF_TIME_MS=750
EEZ_SUBMISSION_SLACK_MS=700
EEZ_PREPARATION_TIME_MS=500
# Earliest builder dispatch is T-7.5s (rbuilder-style T-8s bidding gate).
# EEZ_BUNDLE_SUBMISSION_LEAD_MS=7500
# Optional tip-following RPC for target-block selection.
# EEZ_L1_TARGET_RPC_URL=
# EEZ_MAX_POSTBATCH_GAS=16777216
# EEZ_L1_REORG_MAX_DEPTH_BLOCKS=62

# ── Settlement policy and fee limits (required) ─────────────────────
# docs/configurable-settlement-policy.md. There are no Ethereum defaults: the
# node refuses to start until these are set. Fee values are per-unit prices in
# wei (not total spending caps); every settlement spends real ETH.
# EEZ_MAX_BLOCKS_PER_BATCH was removed and must remain absent.
EEZ_SETTLEMENT_PURE_L2_MODE=interval
EEZ_SETTLEMENT_PURE_L2_INTERVAL_MS=900000
EEZ_SETTLEMENT_MAX_UNSETTLED_L2_BLOCKS=150
EEZ_MAX_SPECULATIVE_DEPTH=0
# Choose and uncomment (wei per gas / per blob gas):
# EEZ_L1_POSTBATCH_MAX_FEE_PER_GAS=
# EEZ_L1_POSTBATCH_MAX_FEE_PER_BLOB_GAS=
# EEZ_L1_POSTBATCH_MIN_PRIORITY_FEE=
# EEZ_L1_POSTBATCH_MAX_PRIORITY_FEE=
# Optional: fixed priority fee instead of canonical fee history.
# EEZ_L1_POSTBATCH_PRIORITY_FEE=
# EEZ_SETTLEMENT_BLOB_FULLNESS_BPS=1000
# EEZ_MAX_BLOBS_PER_BATCH=
# EEZ_L1_POSTBATCH_EXECUTION_HEADROOM_BPS=10000
# EEZ_L1_POSTBATCH_BLOB_HEADROOM_BPS=10000
# EEZ_L1_POSTBATCH_GAS_MARGIN_BPS=500
