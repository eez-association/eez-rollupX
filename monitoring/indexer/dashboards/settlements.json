      "id": 5,
      "type": "stat",
      "title": "History coverage",
      "description": "Indexed block height, distance to the last observed head, and age of the last successful check. Increasing check age means this history may no longer reflect the current chain.",
      "datasource": {
        "type": "postgres",
        "uid": "eez-indexer-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT max(height) FROM eez_indexer.blocks) AS \"Indexed L1 block\", CASE WHEN observed_head IS NOT NULL THEN greatest(observed_head-coalesce((SELECT max(height) FROM eez_indexer.blocks), start_block-1),0) END AS \"Blocks behind\", extract(epoch FROM now()-checked_at)::float8 AS \"Last checked\" FROM eez_indexer.source"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Starting"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last checked"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
