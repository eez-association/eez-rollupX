{
  "uid": "eez-settlement-history",
  "title": "EEZ Settlement history",
  "description": "Canonical L1 commitment events and the exact receipts that paid for their transactions.",
  "tags": [
    "eez",
    "settlement"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "l1_explorer",
        "label": "L1 explorer URL",
        "type": "textbox",
        "query": "https://gnosis-chiado.blockscout.com",
        "current": {
          "text": "https://gnosis-chiado.blockscout.com",
          "value": "https://gnosis-chiado.blockscout.com"
        }
      },
      {
        "name": "l2_explorer",
        "label": "L2 explorer URL",
        "type": "textbox",
        "query": "https://eez.asuscomm.com:4445",
        "current": {
          "text": "https://eez.asuscomm.com:4445",
          "value": "https://eez.asuscomm.com:4445"
        }
      },
      {
        "name": "blob_explorer",
        "label": "Blob explorer URL",
        "type": "textbox",
        "query": "https://eez.asuscomm.com:4443",
        "current": {
          "text": "https://eez.asuscomm.com:4443",
          "value": "https://eez.asuscomm.com:4443"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Latest settled commitment",
      "description": "Latest blob-posting transaction with commitment updates. Each transaction appears once, with its number of commitment updates. Last L2 block is the endpoint of the correlated batch range, including completion by companion transactions; it stays blank until range data is available. Additional rows only list extra blob hashes or batch ranges. Non-blob execution updates are excluded from this table. Batch L2 range belongs to the posting and can include blocks completed by companion transactions; it is not the span of one emitted commitment. Gas limit used is receipt gas / signed transaction gas limit, not block capacity or the fee charged. Blob usage is occupied stream bytes / usable capacity (126976 bytes per blob). L2 burned fees and L2 tip fees total execution charges across each finalized batch range, including system and reverted transactions; they stay blank until all receipts are collected. These are separate from L1 posting costs.",
      "datasource": {
        "type": "postgres",
        "uid": "eez-indexer-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH updates AS (SELECT *, row_number() OVER (PARTITION BY l1_block_hash,transaction_hash ORDER BY log_index DESC) AS update_rank, count(*) OVER (PARTITION BY l1_block_hash,transaction_hash) AS update_count FROM eez_indexer.settlement_history), latest AS (SELECT * FROM updates WHERE update_rank=1 AND EXISTS (SELECT 1 FROM eez_indexer.transactions posting WHERE posting.block_hash=updates.l1_block_hash AND posting.transaction_hash=updates.transaction_hash AND posting.blob_gas_used > 0) ORDER BY l1_block DESC,log_index DESC LIMIT 1) SELECT CASE WHEN coalesce(parts.n,1)=1 THEN h.time END AS \"L1 time\", CASE WHEN coalesce(parts.n,1)=1 THEN extract(epoch FROM now()-h.time)::float8 END AS \"Elapsed\", CASE WHEN coalesce(parts.n,1)=1 THEN h.l1_block END AS \"L1 block\", CASE WHEN coalesce(parts.n,1)=1 THEN h.l1_block_hash END AS \"l1_hash\", CASE WHEN coalesce(parts.n,1)=1 THEN h.transaction_hash END AS \"Transaction\", CASE WHEN coalesce(parts.n,1)=1 THEN CASE WHEN t.blob_gas_used > 0 THEN 'Blob posting' ELSE 'Execution update' END END AS \"Type\", CASE WHEN coalesce(parts.n,1)=1 THEN h.update_count END AS \"Commitment updates\", (parts.r->>'last')::bigint AS \"Last L2 block\", CASE WHEN coalesce(parts.n,1)=1 THEN t.gas_used::float8 END AS \"Gas used\", CASE WHEN coalesce(parts.n,1)=1 THEN (d.data#>>'{transaction,gasLimit}')::float8 END AS \"Gas limit\", CASE WHEN coalesce(parts.n,1)=1 THEN 100*t.gas_used::float8/nullif((d.data#>>'{transaction,gasLimit}')::float8,0) END AS \"Gas limit used\", CASE WHEN coalesce(parts.n,1)=1 THEN (d.data#>>'{beacon,usedBytes}')::bigint END AS \"Blob bytes used\", CASE WHEN coalesce(parts.n,1)=1 THEN (t.blob_gas_used/131072*126976)::bigint END AS \"Blob capacity\", CASE WHEN coalesce(parts.n,1)=1 THEN 100*(d.data#>>'{beacon,usedBytes}')::float8/nullif(t.blob_gas_used/131072*126976,0) END AS \"Blob usage\", CASE WHEN coalesce(parts.n,1)=1 THEN (t.blob_gas_used/131072)::bigint END AS \"Blobs\", CASE WHEN coalesce(parts.n,1)=1 THEN CASE WHEN d.data#>>'{beacon,source}' <> 'no blobs' THEN (d.data#>>'{beacon,blobCount}')::bigint END END AS \"Beacon blobs (L1 block)\", CASE WHEN coalesce(parts.n,1)=1 THEN (t.execution_fee_wei/1e18)::float8 END AS \"Execution fee\", CASE WHEN coalesce(parts.n,1)=1 THEN (t.blob_fee_wei/1e18)::float8 END AS \"Blob fee\", CASE WHEN coalesce(parts.n,1)=1 THEN ((t.execution_fee_wei+t.blob_fee_wei)/1e18)::float8 END AS \"Total fee\", CASE WHEN coalesce(parts.n,1)=1 THEN 'Succeeded' END AS \"Result\", CASE WHEN parts.r IS NOT NULL THEN (parts.r->>'first')||' \u2192 '||(parts.r->>'last')||' ('||(parts.r->>'count')||' blocks)' WHEN coalesce(parts.n,1)=1 AND t.blob_gas_used > 0 AND d.data#>'{ranges,items}' IS NULL THEN 'Pending' END AS \"Batch L2 range\", parts.r->>'state' AS \"L2 status\", CASE WHEN parts.f->>'status'='available' AND parts.f->'range'=parts.r THEN ((parts.f->>'burnWei')::numeric/1e18)::float8 END AS \"L2 burned fees\", CASE WHEN parts.f->>'status'='available' AND parts.f->'range'=parts.r THEN ((parts.f->>'tipWei')::numeric/1e18)::float8 END AS \"L2 tip fees\", parts.r->>'firstHash' AS first_hash, parts.r->>'lastHash' AS last_hash, parts.blob AS \"Blob hash\" FROM latest h JOIN eez_indexer.transactions t ON t.block_hash=h.l1_block_hash AND t.transaction_hash=h.transaction_hash LEFT JOIN eez_indexer.details d ON d.block_hash=h.l1_block_hash AND d.transaction_hash=h.transaction_hash LEFT JOIN LATERAL ROWS FROM (jsonb_array_elements(d.data#>'{ranges,items}'),jsonb_array_elements_text(d.data#>'{transaction,blobHashes}'),jsonb_array_elements(d.data#>'{l2Fees,items}')) WITH ORDINALITY AS parts(r,blob,f,n) ON true ORDER BY parts.n"
        }
      ],
      "fieldConfig": {
