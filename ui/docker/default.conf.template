server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /rpc/l1 {
        proxy_pass ${EEZ_UI_L1_RPC_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /rpc/l2 {
        proxy_pass ${EEZ_UI_L2_RPC_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /composer/l1 {
        proxy_pass ${EEZ_UI_L1_FRONT_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /composer/l2 {
        proxy_pass ${EEZ_UI_L2_FRONT_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
