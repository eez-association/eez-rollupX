# syntax=docker/dockerfile:1.7

FROM rust:1.95-bookworm AS builder
COPY scripts/ci/install-llvm.sh /usr/local/lib/eez/install-llvm.sh
RUN bash /usr/local/lib/eez/install-llvm.sh
ENV LLVM_SYS_221_PREFIX=/usr/lib/llvm-22
ENV PATH="/usr/lib/llvm-22/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates clang cmake git libclang-dev libssl-dev pkg-config protobuf-compiler mold \
    && rm -rf /var/lib/apt/lists/*
# mold for fast final links; Docker-only on purpose — host builds keep
# the default linker (see the matching comment in Dockerfile).
ENV RUST_MIN_STACK=16777216
ENV RUSTFLAGS="-C link-arg=-fuse-ld=mold"
WORKDIR /build

# Build the signer from the repository workspace and its shared lockfile.
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

ENV CARGO_TARGET_DIR=/build/target

# `release` (workspace profile: cgu=16, stripped, thin LTO) is the
# fast-to-build default; BUILD_PROFILE=maxperf for production binaries.
ARG BUILD_PROFILE=release
RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=eez-proof-signer-target,target=/build/target,sharing=locked \
    cargo build \
        --profile "$BUILD_PROFILE" \
        --locked \
        --package eez-proof-signer \
        --bin eez-proof-signer \
    && install -D -m 0555 "/build/target/$BUILD_PROFILE/eez-proof-signer" /out/eez-proof-signer

FROM debian:bookworm-slim AS runtime
# The L1 reader's TLS client loads the system trust store for HTTPS RPC URLs.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder --chmod=0555 /out/eez-proof-signer /usr/local/bin/eez-proof-signer
WORKDIR /app
USER 65532:65532
EXPOSE 50061/tcp
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/eez-proof-signer"]
